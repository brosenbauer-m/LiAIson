# Copy to .env.local and fill in. Never commit real values.

# Supabase (EU West, Ireland)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mistral AI (all LiAIson agents)
MISTRAL_API_KEY=your_mistral_api_key

# Upstash Redis (rate limiting) — set by the Vercel Upstash integration
KV_REST_API_URL=your_upstash_rest_url
KV_REST_API_TOKEN=your_upstash_rest_token

# Scaleway Transactional Email (notification digests, fr-par)
# Secret key of the IAM application with TransactionalEmail send permissions
SCW_SECRET_KEY=your_scaleway_secret_key
SCW_PROJECT_ID=your_scaleway_project_id

# Mollie (payments, Netherlands) — test_… key in test mode, live_… once live
MOLLIE_API_KEY=your_mollie_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_cron_secret
